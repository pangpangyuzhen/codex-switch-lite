{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch Lite",
  "version": "0.1.0",
  "identifier": "com.codexswitch.lite",
  "build": {
    "beforeDevCommand": "pnpm dev:web -- --host 127.0.0.1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Switch Lite",
        "width": 940,
        "height": 780,
        "minWidth": 720,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Switch Codex Desktop between ChatGPT Plus and an External API",
    "longDescription": "A lightweight Codex-only provider switcher derived from CC Switch's official-auth preservation approach.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
